rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /invitaciones/{token} {
      // Consultar una invitación puntual (token ya conocido) sigue siendo
      // pública: lo necesita la página de canje sin que la persona esté
      // logueada todavía. Listar la colección completa (y así enumerar
      // todos los tokens/emails invitados) queda restringido a admins.
      allow get: if true;
      allow list: if request.auth != null &&
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'];
      // Admins: acceso total. Usuarios: solo pueden marcar su propia invitación como usada.
      allow create, delete: if request.auth != null &&
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'];
      allow update: if request.auth != null && (
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'] ||
        (
          !resource.data.usado &&
          (!('email' in resource.data) || resource.data.email == request.auth.token.email)
        )
      );
    }

    match /usuarios/{email} {
      allow read: if request.auth != null && (
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'] ||
        request.auth.token.email == email
      );

      // Un usuario puede crear su propio documento al registrarse, pero sin
      // poder otorgarse cursos y con un nombre validado (string, <=100 chars).
      allow create: if request.auth != null && (
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'] ||
        (
          request.auth.token.email == email &&
          request.resource.data.cursos == [] &&
          request.resource.data.cohorte is string &&
          (!('nombre' in request.resource.data) || (
            request.resource.data.nombre is string &&
            request.resource.data.nombre.size() <= 100
          ))
        )
      );

      // Lxs admins pueden modificar cualquier campo. Un usuario puede
      // actualizar unicamente el "nombre" de su propio documento (pantalla
      // de "Mi cuenta"), nunca cursos/cohorte ni el de otra persona.
      allow update: if request.auth != null && (
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'] ||
        (
          request.auth.token.email == email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre']) &&
          request.resource.data.nombre is string &&
          request.resource.data.nombre.size() <= 100
        )
      );

      allow delete: if request.auth != null &&
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'];
    }

    match /pagos_procesados/{id} {
      allow read, write: if false;
    }

    match /ordenes_paypal/{id} {
      allow read, write: if false;
    }

    match /rate_limits/{id} {
      allow read, write: if false;
    }

    // Cada cuánto ya se avisó de algo (hoy, que GeoNames dejó de atender):
    // lo escribe solo la Cloud Function.
    match /avisos/{id} {
      allow read, write: if false;
    }

    match /codigos_descuento/{codigo} {
      // Lectura de un código puntual (ya conocido) sigue siendo publica, la
      // usa la pagina de checkout para validar el cupon que escribe el usuario.
      // Listar la coleccion completa (y asi enumerar todos los codigos) queda
      // restringido a admins.
      allow get: if true;
      allow list: if request.auth != null &&
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'];
      allow write: if request.auth != null &&
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'];
    }

    match /cursos/{id} {
      // Solo admins o quien ya compro ese curso puede leer la lista completa
      // de videos. La clase gratis (primer video) se sirve aparte via la
      // Cloud Function obtenerMuestra, que no requiere login.
      allow read: if request.auth != null && (
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'] ||
        (id in get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data.cursos)
      );
      allow write: if request.auth != null &&
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'];
    }

    match /enlaces/{token} {
      // Admins crean y gestionan los enlaces desde el panel.
      // La Cloud Function activarEnlace (Admin SDK) los lee e incrementa usos
      // sin pasar por estas reglas.
      allow read, write: if request.auth != null &&
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'];
    }

    match /regalos/{codigo} {
      // Los codigos de regalo se crean, se canjean y se marcan usados
      // exclusivamente desde Cloud Functions (Admin SDK), que no pasan por
      // estas reglas. Ningun cliente deberia leer ni escribir directo.
      allow read, write: if false;
    }

    match /compras/{id} {
      // Registro de cada compra con su origen (utm/gclid). Lo escriben solo
      // las Cloud Functions (Admin SDK); lo leen lxs admins en /escuela/admin.
      allow write: if false;
      allow read: if request.auth != null &&
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'];
    }

    match /facturas/{id} {
      // Las facturas C emitidas ante AFIP. Las escribe solo el facturador local
      // (Admin SDK, no pasa por estas reglas); lxs admins las leen en el panel.
      // Un comprobante emitido no se borra: se anula con nota de credito.
      allow write: if false;
      allow read: if request.auth != null &&
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'];
    }

    match /facturacion_estado/{id} {
      // Candado para que no haya dos emisiones a la vez. Solo Admin SDK.
      allow read, write: if false;
    }

    // ---------- Calculadora de cartas (/tucarta) ----------

    // Textos de Sol, Luna y Ascendente y links de los botones: los lee
    // cualquiera (la calculadora no pide login), los escriben lxs admins.
    match /tucarta_textos/{id} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'];
    }
    match /tucarta_config/{id} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'];
    }

    // Perfil de cada cuenta en la calculadora: aceptacion del aviso de
    // privacidad y si quiere novedades. Lxs admins lo leen (para la lista
    // de novedades); las cartas de adentro, no.
    match /tucarta_usuarios/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com']
      );
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['email', 'novedades', 'aceptado']) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.novedades is bool &&
        request.resource.data.aceptado is string && request.resource.data.aceptado.size() <= 40;
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Cartas guardadas (con datos de nacimiento): solo la persona duena.
      match /cartas/{id} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid &&
          cartaValida(request.resource.data);
      }
    }

    function cartaValida(d) {
      return d.keys().hasOnly(['nombre', 'fecha', 'hora', 'lugar', 'correccion', 'eleccion', 'tipo', 'grupo', 'guardada']) &&
        (!('tipo' in d) || d.tipo in ['natal', 'revolucion', 'progresion', 'evento']) &&
        (!('grupo' in d) || (d.grupo is string && d.grupo.size() <= 60)) &&
        d.nombre is string && d.nombre.size() <= 60 &&
        d.fecha is string && d.fecha.size() == 10 &&
        d.hora is string && d.hora.size() == 5 &&
        d.lugar is map &&
        d.lugar.keys().hasOnly(['nombre', 'provincia', 'pais', 'paisNombre', 'lat', 'lon', 'zona', 'manual']) &&
        d.lugar.lat is number && d.lugar.lon is number &&
        d.lugar.zona is string && d.lugar.zona.size() <= 64 &&
        d.lugar.get('nombre', '').size() <= 200 &&
        (d.correccion == null || (d.correccion is map && d.correccion.keys().hasOnly(['base', 'verano']))) &&
        d.eleccion is int && d.eleccion >= 0 && d.eleccion <= 1 &&
        d.guardada is string && d.guardada.size() <= 40;
    }

    match /envios_carta/{id} {
      // Mails de confirmacion de las inscripciones (con la carta en PDF):
      // los escriben y los leen solo las Cloud Functions.
      allow read, write: if false;
    }

    match /pedidos/{id} {
      // Solo se escribe desde la Cloud Function guardarPedido (Admin SDK,
      // no pasa por estas reglas). Ningun cliente deberia escribir directo.
      allow write: if false;
      allow read: if request.auth != null &&
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'];
    }

    match /brevo_contactos/{id} {
      // La cola de altas en el mailing: la llenan las Cloud Functions y la
      // vacia el trigger sincronizarContactoBrevo. Ningun cliente la toca.
      allow read, write: if false;
    }

    match /suscripciones/{email} {
      // La constancia de cada consentimiento (origen, fecha e IP de quien
      // se suscribio). La escribe solo la funcion suscribir; se lee desde
      // el panel si hay que mostrar de donde salio una direccion.
      allow write: if false;
      allow read: if request.auth != null &&
        request.auth.token.email in ['sebruz@gmail.com', 'espaciointeriorastrologia@gmail.com'];
    }
  }
}
