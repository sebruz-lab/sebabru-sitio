rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // QUIEN ADMINISTRA. Un solo lugar, y con el mail verificado.
    //
    // Dos cosas cambiaron el 28/11/2026, y conviene entender las dos.
    //
    // 1) Antes esta lista estaba escrita DIECIOCHO veces en este archivo.
    //    Sacar a alguien era acertar dieciocho veces. Ahora es una.
    //
    // 2) Antes no se miraba email_verified, en ningun lado del proyecto.
    //    Eso importa porque el sitio crea cuentas con createUserWith-
    //    EmailAndPassword y nunca mandaba el mail de verificacion: o sea
    //    que cualquiera podia registrarse con una direccion que no es suya
    //    y el token que salia de ahi traia ese mail igual. Si alguna de las
    //    tres direcciones de aca no tuviera cuenta, registrarla seria
    //    quedar admin de todo: el padron con los datos de nacimiento y la
    //    plata, Finanzas, la agenda de consultantes y los titulos con DNI.
    //
    //    Hoy las tres tienen cuenta, asi que con "una cuenta por direccion"
    //    activado en la consola (el valor de fabrica) no era explotable. Eso
    //    es una casualidad afortunada, no un control: un cambio en una
    //    pantalla de la consola alcanzaba para abrirlo. Ahora la condicion
    //    esta escrita.
    //
    // Quien entra con Google ya trae email_verified en true, asi que esto no
    // le pide nada. A quien entra con mail y contrasena le pide verificar,
    // que es exactamente lo que tiene que pasar.
    //
    // OJO: esto NO se usa para la rama de cada persona sobre su propio
    // documento. Ahi seguir pidiendo verificacion romperia el registro y la
    // entrada a las aulas de todo el mundo (al crear la cuenta el mail
    // todavia no esta verificado). Lo que cubre ese caso es que la rama
    // propia no puede darse cursos, y que los canjes -- donde esta la plata
    // -- piden la verificacion del lado del servidor, en las callables.
    function esAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'sebruz@gmail.com',
          'espaciointeriorastrologia@gmail.com',
          'info@sebabru.com'
        ];
    }

    match /invitaciones/{token} {
      // Consultar una invitación puntual (token ya conocido) sigue siendo
      // pública: lo necesita la página de canje sin que la persona esté
      // logueada todavía. Listar la colección completa (y así enumerar
      // todos los tokens/emails invitados) queda restringido a admins.
      allow get: if true;
      allow list: if request.auth != null &&
        esAdmin();
      // Solo admins escriben desde un cliente. Quien canjea una invitación no
      // escribe nada acá: lo hace la Cloud Function activarInvitacion con el
      // Admin SDK, que no pasa por estas reglas.
      //
      // Antes había una rama que dejaba a cualquier persona autenticada
      // actualizar una invitación no usada. No limitaba qué campos se
      // escribían y además miraba el campo "email", mientras que quien manda
      // la invitación guarda el destinatario en "emailDestino": como
      // "email" no existía en el documento, la condición daba verdadero
      // siempre. Con eso se podía reescribir emailDestino y cursoId de una
      // invitación ajena y después canjearla. Se quitó el 2026-11-13.
      allow create, update, delete: if request.auth != null &&
        esAdmin();
    }

    match /usuarios/{email} {
      allow read: if request.auth != null && (
        esAdmin() ||
        request.auth.token.email == email
      );

      // Un usuario puede crear su propio documento al registrarse, pero sin
      // poder otorgarse cursos y con un nombre validado (string, <=100 chars).
      //
      // El hasOnly y el tope de cohorte son del 28/11/2026, y lo que cierran
      // es una inconsistencia: el update de la rama propia ya estaba acotado
      // a ['nombre','novedades'], pero el create no tenia ninguna lista, asi
      // que al registrarse se podia escribir cualquier campo con cualquier
      // valor -- un 'cohorte' de un megabyte, o campos inventados que nadie
      // vuelve a mirar. No habia escalada (cursos == [] siempre estuvo), era
      // un documento de forma libre y consumo gratis.
      //
      // La lista es la que escriben los tres lugares que dan de alta:
      // escuela.js (con Google y con contrasena) y canjear/index.html.
      allow create: if request.auth != null && (
        esAdmin() ||
        (
          request.auth.token.email == email &&
          request.resource.data.keys().hasOnly(
            ['cursos', 'nombre', 'cohorte', 'novedades', 'fechaRegistro']) &&
          request.resource.data.cursos == [] &&
          request.resource.data.cohorte is string &&
          request.resource.data.cohorte.size() <= 20 &&
          // El null es a proposito: escuela.js escribe
          // nombre: user.displayName, y una cuenta de Google sin nombre para
          // mostrar manda null. Con la condicion vieja esa persona no podia
          // crear su documento y el registro le fallaba sin explicacion.
          (!('nombre' in request.resource.data) ||
            request.resource.data.nombre == null || (
            request.resource.data.nombre is string &&
            request.resource.data.nombre.size() <= 100
          )) &&
          (!('novedades' in request.resource.data) ||
            request.resource.data.novedades is bool) &&
          (!('fechaRegistro' in request.resource.data) ||
            request.resource.data.fechaRegistro is timestamp)
        )
      );

      // Lxs admins pueden modificar cualquier campo. Un usuario puede
      // actualizar unicamente el "nombre" de su propio documento (pantalla
      // de "Mi cuenta") y el casillero "novedades" (el de la lista de
      // correo, que esta en el modal de ingreso), nunca cursos/cohorte ni
      // el documento de otra persona.
      allow update: if request.auth != null && (
        esAdmin() ||
        (
          request.auth.token.email == email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'novedades']) &&
          (!('nombre' in request.resource.data) || (
            request.resource.data.nombre is string &&
            request.resource.data.nombre.size() <= 100
          )) &&
          (!('novedades' in request.resource.data) ||
            request.resource.data.novedades is bool)
        )
      );

      allow delete: if request.auth != null &&
        esAdmin();
    }

    match /pagos_procesados/{id} {
      allow read, write: if false;
    }

    match /ordenes_paypal/{id} {
      allow read, write: if false;
    }

    match /rate_limits/{id} {
      allow read, write: if false;
    }

    // Cuantas altas entraron cada dia y por que motivo se rechazaron las que
    // se rechazaron. Un documento por fecha, lo escribe solo la function.
    // Tambien hace de contador del tope diario de mails, asi que si el
    // navegador pudiera escribirlo podria apagar el tope.
    match /metricas_suscribir/{fecha} {
      allow read, write: if false;
    }

    // Lo que alguien escribio y el flujo no pudo procesar: se guarda en vez
    // de perderse y Seba lo carga a mano. Cerrada de los dos lados, y esta
    // importa: adentro hay DNI, direcciones de envio y datos de nacimiento
    // de gente que ni siquiera llego a completar su tramite. El panel la lee
    // por function con sesion de admin, nunca desde el navegador.
    // Los documentos se borran solos a los 90 dias por la politica de TTL
    // sobre el campo "expira".
    match /datos_sin_procesar/{id} {
      allow read, write: if false;
    }

    // EL PADRON DE LA ESCUELA. Una fila por persona por curso: mail,
    // telefono, datos de nacimiento y la plata de cada estudiante. Es la
    // coleccion mas sensible de la escuela, asi que va cerrada de los dos
    // lados aunque el resto del panel de la escuela lea Firestore directo:
    // el mismo criterio que agenda_pedidos y titulos, un poco mas abajo.
    // Todo pasa por la callable adminPadron, que verifica la sesion de admin
    // del lado del servidor y deja auditoria en padron_movimientos.
    match /padron/{id} {
      allow read, write: if false;
    }
    // Las columnas de cada curso. Cerrada por lo mismo, aunque no tenga
    // datos de nadie: si se pudiera escribir desde el navegador se podrian
    // inventar columnas, y el valor de una columna vive en el padron.
    match /padron_columnas/{cursoId} {
      allow read, write: if false;
    }
    // Quien cambio que. No se lee ni se escribe desde el cliente: una
    // auditoria que el auditado puede editar no es una auditoria.
    match /padron_movimientos/{id} {
      allow read, write: if false;
    }
    // La cola que llena el padron. Guarda la carga cruda del formulario, asi
    // que tambien se borra sola a los 90 dias por el TTL sobre "expira".
    match /padron_pendientes/{id} {
      allow read, write: if false;
    }

    // FINANZAS. Lo que entra a la escuela, lo que le toca a Clari y los
    // ingresos que no pasaron por el sitio. Cerradas de los dos lados por lo
    // mismo que el padron, y con mas razon: una sola de estas colecciones
    // alcanza para reconstruir cuanto factura la escuela. Todo pasa por la
    // callable adminFinanzas, que deja auditoria en finanzas_movimientos.
    match /finanzas_clari/{id} {
      allow read, write: if false;
    }
    match /finanzas_ingresos/{id} {
      allow read, write: if false;
    }
    match /finanzas_config/{id} {
      allow read, write: if false;
    }
    match /finanzas_movimientos/{id} {
      allow read, write: if false;
    }

    // Cada cuánto ya se avisó de algo (hoy, que GeoNames dejó de atender):
    // lo escribe solo la Cloud Function.
    match /avisos/{id} {
      allow read, write: if false;
    }

    match /codigos_descuento/{codigo} {
      // Lectura de un código puntual (ya conocido) sigue siendo publica, la
      // usa la pagina de checkout para validar el cupon que escribe el usuario.
      // Listar la coleccion completa (y asi enumerar todos los codigos) queda
      // restringido a admins.
      allow get: if true;
      allow list: if request.auth != null &&
        esAdmin();
      allow write: if request.auth != null &&
        esAdmin();
    }

    match /cursos/{id} {
      // Solo admins o quien ya compro ese curso puede leer la lista completa
      // de videos. La clase gratis (primer video) se sirve aparte via la
      // Cloud Function obtenerMuestra, que no requiere login.
      allow read: if request.auth != null && (
        esAdmin() ||
        (id in get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data.cursos)
      );
      allow write: if request.auth != null &&
        esAdmin();
    }

    match /enlaces/{token} {
      // Admins crean y gestionan los enlaces desde el panel.
      // La Cloud Function activarEnlace (Admin SDK) los lee e incrementa usos
      // sin pasar por estas reglas.
      allow read, write: if request.auth != null &&
        esAdmin();
    }

    match /regalos/{codigo} {
      // Los codigos de regalo se crean, se canjean y se marcan usados
      // exclusivamente desde Cloud Functions (Admin SDK), que no pasan por
      // estas reglas. Ningun cliente deberia leer ni escribir directo.
      allow read, write: if false;
    }

    match /compras/{id} {
      // Registro de cada compra con su origen (utm/gclid). Lo escriben solo
      // las Cloud Functions (Admin SDK); lo leen lxs admins en /escuela/admin.
      allow write: if false;
      allow read: if request.auth != null &&
        esAdmin();
    }

    match /facturas/{id} {
      // Las facturas C emitidas ante AFIP. Las escribe solo el facturador local
      // (Admin SDK, no pasa por estas reglas); lxs admins las leen en el panel.
      // Un comprobante emitido no se borra: se anula con nota de credito.
      allow write: if false;
      allow read: if request.auth != null &&
        esAdmin();
    }

    match /facturacion_estado/{id} {
      // Candado para que no haya dos emisiones a la vez. Solo Admin SDK.
      allow read, write: if false;
    }

    // ---------- Calculadora de cartas (/tucarta) ----------

    // Textos de Sol, Luna y Ascendente y links de los botones: los lee
    // cualquiera (la calculadora no pide login), los escriben lxs admins.
    match /tucarta_textos/{id} {
      allow read: if true;
      allow write: if request.auth != null &&
        esAdmin();
    }
    match /tucarta_config/{id} {
      allow read: if true;
      allow write: if request.auth != null &&
        esAdmin();
    }

    // Perfil de cada cuenta en la calculadora: aceptacion del aviso de
    // privacidad y si quiere novedades. Lxs admins lo leen (para la lista
    // de novedades); las cartas de adentro, no.
    match /tucarta_usuarios/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        esAdmin()
      );
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['email', 'novedades', 'aceptado']) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.novedades is bool &&
        request.resource.data.aceptado is string && request.resource.data.aceptado.size() <= 40;
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Cartas guardadas (con datos de nacimiento): solo la persona duena.
      match /cartas/{id} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid &&
          cartaValida(request.resource.data);
      }
    }

    function cartaValida(d) {
      return d.keys().hasOnly(['nombre', 'fecha', 'hora', 'lugar', 'correccion', 'eleccion', 'tipo', 'grupo', 'guardada']) &&
        (!('tipo' in d) || d.tipo in ['natal', 'revolucion', 'progresion', 'evento']) &&
        (!('grupo' in d) || (d.grupo is string && d.grupo.size() <= 60)) &&
        d.nombre is string && d.nombre.size() <= 60 &&
        d.fecha is string && d.fecha.size() == 10 &&
        d.hora is string && d.hora.size() == 5 &&
        d.lugar is map &&
        d.lugar.keys().hasOnly(['nombre', 'provincia', 'pais', 'paisNombre', 'lat', 'lon', 'zona', 'manual']) &&
        d.lugar.lat is number && d.lugar.lon is number &&
        d.lugar.zona is string && d.lugar.zona.size() <= 64 &&
        d.lugar.get('nombre', '').size() <= 200 &&
        (d.correccion == null || (d.correccion is map && d.correccion.keys().hasOnly(['base', 'verano']))) &&
        d.eleccion is int && d.eleccion >= 0 && d.eleccion <= 1 &&
        d.guardada is string && d.guardada.size() <= 40;
    }

    match /envios_carta/{id} {
      // Mails de confirmacion de las inscripciones (con la carta en PDF):
      // los escriben y los leen solo las Cloud Functions.
      allow read, write: if false;
    }

    match /pedidos/{id} {
      // Solo se escribe desde la Cloud Function guardarPedido (Admin SDK,
      // no pasa por estas reglas). Ningun cliente deberia escribir directo.
      allow write: if false;
      allow read: if request.auth != null &&
        esAdmin();
    }

    match /brevo_contactos/{id} {
      // La cola de altas en el mailing: la llenan las Cloud Functions y la
      // vacia el trigger sincronizarContactoBrevo. Ningun cliente la toca.
      allow read, write: if false;
    }

    match /inscripciones_pendientes/{id} {
      // La carga cruda de un formulario sin agenda, desde que
      // registrarInscripcion contesta hasta que procesarInscripcion termina
      // de repartirla. Tiene todo lo que la persona escribio, datos de
      // nacimiento incluidos. Cerrada de los dos lados.
      allow read, write: if false;
    }

    match /filas_planilla/{id} {
      // La cola de la planilla: la llenan las Cloud Functions y la vacia el
      // trigger escribirFilaPlanilla. Cada documento tiene la fila entera de
      // una inscripcion, o sea nombre, telefono, email y datos de
      // nacimiento. Cerrada de los dos lados.
      allow read, write: if false;
    }

    match /mails_salientes/{id} {
      // La cola de mails: la llenan las Cloud Functions y la vacia el
      // trigger enviarMailEncolado. Cerrada de los dos lados, y no por
      // formalidad: cada documento tiene el cuerpo del mail armado, o sea
      // nombre, direccion y telefono de quien se inscribio o compro.
      allow read, write: if false;
    }

    match /certificados/{email} {
      // Quien tiene certificado de egreso y cual es su archivo. Lo lee la
      // Cloud Function descargarCertificado con el Admin SDK, que no pasa por
      // estas reglas. Cerrado a los clientes a proposito: si un navegador
      // pudiera leer la coleccion, se sabria quienes son todos los egresados
      // y con que mail, y el nombre del archivo volveria a ser adivinable.
      allow read, write: if false;
    }

    // Los titulos de egreso que emite la gente desde /escuela/certificados/.
    // Cada documento lleva el nombre y el DNI impresos en el PDF, asi que la
    // coleccion esta cerrada de los dos lados: la escribe emitirTitulo y la
    // lee descargarTitulo, las dos con el Admin SDK, que no pasa por estas
    // reglas. Si un navegador pudiera leerla tendria el padron de egresadxs
    // con DNI incluido.
    match /titulos/{id} {
      allow read, write: if false;
    }

    // La cola del mail con el titulo adjunto. Misma razon que envios_carta:
    // tiene los datos crudos mientras el trigger arma el PDF.
    match /envios_titulo/{id} {
      allow read, write: if false;
    }

    // El padron de la formacion de cuatro anos. No hay un aula que la
    // represente, asi que quien egreso se carga a mano aca:
    //   titulos_habilitados/{email} -> { formaciones: ['formacion'] }
    // Cerrada al cliente: si el navegador pudiera escribirla, cualquiera se
    // daria de alta un titulo.
    match /titulos_habilitados/{email} {
      allow read, write: if false;
    }

    // Los contadores que numeran los titulos (SB-2026-0001). Nada que un
    // cliente tenga que leer, y menos escribir: de aca sale el numero que
    // despues se verifica en /titulo/.
    match /contadores/{id} {
      allow read, write: if false;
    }

    match /suscripciones/{email} {
      // La constancia de cada consentimiento (origen, fecha e IP de quien
      // se suscribio). La escribe solo la funcion suscribir; se lee desde
      // el panel si hay que mostrar de donde salio una direccion.
      allow write: if false;
      allow read: if request.auth != null &&
        esAdmin();
    }

    // La agenda de las consultas. Las cuatro colecciones estan cerradas al
    // cliente, incluso para Seba: el panel de /consultas/admin/ no lee
    // Firestore directo, pasa por la function adminAgenda, que verifica el
    // ID token y el claim admin. Asi hay un solo camino y un solo lugar
    // donde mirar quien toco que.
    //
    // Y agenda_pedidos ademas guarda nombre, mail y telefono de cada
    // persona: abrirla al cliente seria publicar la lista de consultantes.
    match /agenda_config/{id} {
      allow read, write: if false;
    }
    match /agenda_bloqueos/{id} {
      allow read, write: if false;
    }
    match /agenda_pedidos/{id} {
      allow read, write: if false;
    }
    match /agenda_turnos/{id} {
      allow read, write: if false;
    }

    // Los espacios que Seba abre de vez en cuando y que no quiere en su
    // disponibilidad regular.
    match /agenda_excepcionales/{id} {
      allow read, write: if false;
    }

    // El acompanamiento quincenal: una serie por participante, con su dia,
    // su hora y su ancla. Tiene nombre, mail y telefono, igual que
    // agenda_pedidos: abrirla al cliente seria publicar quienes son.
    match /agenda_series/{id} {
      allow read, write: if false;
    }

    // El historial de movimientos de turnos, y las solicitudes de cambio de
    // horario habitual que quedaron pendientes. La solicitud ademas guarda
    // quien ocupa cada hueco en conflicto, que es un dato que solo Seba
    // puede ver: lo lee el panel por la function, nunca el navegador.
    match /agenda_movimientos/{id} {
      allow read, write: if false;
    }
    match /agenda_solicitudes/{id} {
      allow read, write: if false;
    }

    // Los enlaces de acceso de cada persona. El id del documento es el
    // sha256 del token, asi que el token nunca se guarda y buscarlo es un
    // get directo. Cerrada de los dos lados, y esta es la que mas importa:
    // si un navegador pudiera listarla, tendria los hashes y los mails de
    // todas las personas con acceso.
    match /agenda_accesos/{hash} {
      allow read, write: if false;
    }
  }
}
