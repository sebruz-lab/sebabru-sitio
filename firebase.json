{
  "functions": {
    "source": "functions"
  },
  "firestore": [
    {
      "database": "cursos",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "test/**",
      "test-3d/**",
      "preview-bloques.html",
      "prueba-contenido.html",
      "escuela/abierta/test-descripcion.html",
      "lilith/prototipo-3d.html"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self';"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          },
          {
            "key": "Content-Security-Policy-Report-Only",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://www.googletagmanager.com https://cdnjs.cloudflare.com https://challenges.cloudflare.com https://www.instagram.com https://*.instagram.com https://connect.facebook.net https://embedsocial.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://us-central1-sebabru-e5563.cloudfunctions.net https://challenges.cloudflare.com https://*.google-analytics.com https://*.analytics.google.com https://*.instagram.com; worker-src 'self' blob:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://drive.google.com https://docs.google.com https://open.spotify.com https://forms.gle https://*.mediadelivery.net https://challenges.cloudflare.com https://www.instagram.com; object-src 'none'; base-uri 'self'; form-action 'self' https://docs.google.com; frame-ancestors 'self';"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|gif|svg|ico|mp4|woff2|woff|ttf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "/cartas/@(sw.js|registerSW.js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/cartas/@(lugares|husos)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/escuela/abierta-test",
        "destination": "/escuela/abierta",
        "type": 301
      },
      {
        "source": "/escuela/abierta-test/**",
        "destination": "/escuela/abierta",
        "type": 301
      },
      {
        "source": "/tucarta",
        "destination": "/cartas",
        "type": 301
      },
      {
        "source": "/tucarta/**",
        "destination": "/cartas",
        "type": 301
      },
      {
        "source": "/identidad-astral",
        "destination": "/tu-identidad-en-el-cielo",
        "type": 301
      },
      {
        "source": "/identidad-astral/**",
        "destination": "/tu-identidad-en-el-cielo",
        "type": 301
      },
      {
        "source": "/linaje-clan-y-genealogia-a-traves-de-las-casas-astrologicas",
        "destination": "/escuela/abierta/linaje",
        "type": 301
      },
      {
        "source": "/linaje-clan-y-genealogia-a-traves-de-las-casas-astrologicas/**",
        "destination": "/escuela/abierta/linaje",
        "type": 301
      },
      {
        "source": "/formacion-en-astrologia",
        "destination": "/programa",
        "type": 301
      },
      {
        "source": "/formacion-en-astrologia/**",
        "destination": "/programa",
        "type": 301
      },
      {
        "source": "/neptuno-urano-y-quiron",
        "destination": "/#seminario-singularidad",
        "type": 301
      },
      {
        "source": "/neptuno-urano-y-quiron/**",
        "destination": "/#seminario-singularidad",
        "type": 301
      },
      {
        "source": "/capricornio",
        "destination": "/sol/capricornio",
        "type": 301
      },
      {
        "source": "/capricornio/**",
        "destination": "/sol/capricornio",
        "type": 301
      },
      {
        "source": "/contenidos",
        "destination": "/links",
        "type": 301
      },
      {
        "source": "/contenidos/**",
        "destination": "/links",
        "type": 301
      }
    ]
  }
}
